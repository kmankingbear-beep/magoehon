# 文章・おしゃべりをするAI(Claude)。なければ、おためしの文章で動きます。
ANTHROPIC_API_KEY=
# 挿絵をかくAI(Google Gemini)。なければ OPENAI_API_KEY を使い、どちらもなければ おためしの絵で動きます。
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-3.8-flash   # 文章用(なければ自動でためす)
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_IMAGE_SIZE=2K   # 1K / 2K / 4K(4Kは印刷向きだが時間と費用が増える)
# 予備: OpenAI の画像生成
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Cloudflare Workers AI(無料分あり)。絵はこちらが優先。文章・おしゃべりは ANTHROPIC_API_KEY がないときにこちらを使う
# CLOUDFLARE_TEXT_MODEL=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
